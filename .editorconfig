root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go sources are gofmt-canonical: tabs for indentation, no max line length.
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml,json,md,sh,toml}]
indent_style = space
indent_size = 2

# Windows-only tooling keeps CRLF.
[*.{ps1,bat,cmd}]
end_of_line = crlf
